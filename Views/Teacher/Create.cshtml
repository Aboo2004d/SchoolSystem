@model SchoolSystem.Data.Teacher

@{
    ViewData["Title"] = "إضافة معلم";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> إضافة معلم جديد</h4>
                </div>
                <div class="card-body">
                    <form id="createTeacherForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="nameTeacher" class="form-label">الاسم:</label>
                                    <input id="nameTeacher" name="nameTeacher" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="idNumber" class="form-label">رقم الهوية:</label>
                                    <input id="idNumber" name="idNumber" class="form-control" type="number" autocomplete="off" />
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label">الهاتف:</label>
                                    <input id="phone" name="phone" class="form-control" type="tel" autocomplete="off" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="emailAddressTeacher" class="form-label">البريد الالكتروني:</label>
                                    <input id="emailAddressTeacher" name="emailAddressTeacher" class="form-control" type="email" />
                                </div>
                                
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="city" class="form-label">المدينة:</label>
                                    <input id="city" name="city" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="area" class="form-label ">الحي:</label>
                                    <input id="area" name="area" class="form-control" />
                                </div>

                            </div>

                            <div class="row justify-content-center">
                                <div class="col-md-6 mb-3">
                                    <label for="theDate" class="form-label">تاريخ الميلاد:</label>
                                    <input id="theDate" name="theDate" class="form-control" type="date" />
                                </div>
                            </div>
                            
                            <div class="card-footer d-flex justify-content-center gap-2">
                                <button id="submitBtn" type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-save-fill me-1"></i> حفظ
                                </button>
                                <a class="btn btn-outline-dark px-4" asp-controller="Menegar" asp-action="ManagerMenegarTeacherView">
                                    <i class="bi bi-arrow-left-circle"></i> عودة
                                </a>
                            </div>

                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $("#createTeacherForm").submit(function (e) {
            e.preventDefault(); 
            $("#submitBtn").prop("disabled", true);

            const data = {
                name: $("#nameTeacher").val(),
                idNumber: $("#idNumber").val(),
                phone: $("#phone").val(),
                email: $("#emailAddressTeacher").val(),
                theDate: $("#theDate").val(),
                city: $("#city").val(),
                area: $("#area").val()
            };

            $.ajax({
                url: "/api/teacher/Create",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                    notifySuccess("تم الحفظ بنجاح");

                    setTimeout(() => {
                        window.location.href = "/Menegar/ManagerMenegarTeacherView";
                    }, 1500);
                },
                error: function (xhr) {
                    const errorMsg = xhr.responseJSON?.message || "حدث خطأ غير متوقع";
                    notifyError(errorMsg);
                    $("#submitBtn").prop("disabled", false);
                }
            });
        });
    </script>
}
