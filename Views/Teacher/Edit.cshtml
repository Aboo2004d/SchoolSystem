@{
    ViewData["Title"] = "تعديل المعلم";
    string IdTeacher = ViewBag.Id;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow rounded-4">
        <div class="card-header bg-warning text-dark rounded-top-4 d-flex justify-content-between align-items-center">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square me-2"></i> تعديل بيانات المعلم 
            </h3>
        </div>

        <div class="card-body">
            <form id="editTeacherForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" id="idTeacher" name="idTeacher"/>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="nameTeacher" class="form-label fw-bold">الاسم:</label>
                        <input id="nameTeacher" name="nameTeacher" class="form-control" type="text" />
                        <span id="nameTeacherError" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="idNumber" class="form-label fw-bold">رقم الهوية:</label>
                        <input id="idNumber" name="idNumber" class="form-control" type="number"/>
                        <span id="idNumberError" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="emailAddressTeacher" class="form-label fw-bold">البريد الإلكتروني:</label>
                        <input id="emailAddressTeacher" name="emailAddressTeacher" class="form-control" type="email" />
                        <span id="emailAddressTeacherError" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="phone" class="form-label fw-bold">رقم الجوال:</label>
                        <input id="phone" name="phone" class="form-control" type="text" />
                        <span id="phoneError" class="text-danger small"></span>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="city" class="form-label fw-bold">المدينة:</label>
                        <input id="city" name="City" class="form-control" type="text" />
                        <span id="cityError" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="area" class="form-label fw-bold">الحي:</label>
                        <input id="area" name="area" class="form-control" type="text" />
                        <span id="areaError" class="text-danger small"></span>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="theDate" class="form-label fw-bold">تاريخ الميلاد:</label>
                        <input id="theDate" name="theDate" class="form-control" type="Date" />
                        <span id="theDateError" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="nameSchool" class="form-label fw-bold">المدرسة:</label>
                        <input id="nameSchool" class="form-control" type="text" readonly/>
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-center gap-2">
                    <button id="submitBtn" type="submit" class="btn btn-outline-success">
                        <i class="bi bi-save-fill me-1"></i> حفظ
                    </button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@IdTeacher">
                        <i class="bi bi-arrow-return-left me-1"></i> عودة
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const id = "@IdTeacher"
            if (!id) {
                $("#validationSummary").text("لم يتم تحديد المعلم.");
                return;
            }


            function loadTeacherData() {
                $.when(
                    $.getJSON(`/api/teacher/Edit?id=${id}`)
                ).done(function (teacher) {
                    $('#idTeacher').val(teacher.idTeacher);
                    $('#nameTeacher').val(teacher.nameTeacher);
                    $('#idNumber').val(teacher.idNumber);
                    $('#phone').val(teacher.phone);
                    $('#emailAddressTeacher').val(teacher.emailAddressTeacher);
                    $('#city').val(teacher.city);
                    $('#area').val(teacher.area);
                    $('#nameSchool').val(teacher.nameSchool);
                    $('#theDate').val(teacher.theDate ? teacher.theDate.split('T')[0] : '');
                }).fail(function () {
                    $("#validationSummary").text("فشل في تحميل بيانات المعلم .");
                });
            }

            loadTeacherData();

            function clearErrors() {
                $("#validationSummary").text("");
                $("#nameTeacherError").text("");
                $("#idNumberError").text("");
                $("#phoneError").text("");
                $("#emailAddressTeacherError").text("");
                $("#theDateError").text("");
                $("#cityError").text("");
                $("#areaError").text("");
            }

            // ارسال التعديل
            $("#editTeacherForm").submit(function (e) {
                e.preventDefault();
                clearErrors();
                $("#submitBtn").prop("disabled", true);

                const data = {
                    idTeacher: $('#idTeacher').val(),
                    nameTeacher: $("#nameTeacher").val(),
                    idNumber: $("#idNumber").val(),
                    phone: $("#phone").val(),
                    emailAddressTeacher: $("#emailAddressTeacher").val(),
                    theDate: $("#theDate").val(),
                    city: $("#city").val(),
                    area: $("#area").val()
                };

                $.ajax({
                    url: "/api/teacher/Edit",
                    method: "Put",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (res) {
                        notifySuccess("تم الحفظ بنجاح");
                        setTimeout(() => {
                            window.location.href = "/Teacher/Details?id=" + id;
                        }, 1500);
                    }
                    ,
                    error: function (xhr) {
                        const errorMsg = xhr.responseJSON?.message || "حدث خطأ غير متوقع";
                        notifyError(errorMsg);
                        $("#submitBtn").prop("disabled", false);
                    }
                });
            });
        });
    </script>
}
