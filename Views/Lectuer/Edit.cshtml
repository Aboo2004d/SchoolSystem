@model SchoolSystem.Models.LectuerDataViewModel

@{
    ViewData["Title"] = "تعديل المادة";
    var idLectuer = ViewBag.Id;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-header text-center bg-primary text-white">
                    <h4 class="mb-0">تعديل بيانات المادة</h4>
                </div>
                <div class="card-body">
                    <form id="editLectuerForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" id="Id" name="Id"  />
                        
                        <div class="mb-3">
                            <label for="Name" class="form-label fw-bold">اسم المادة:</label>
                            <input id="Name" name="Name" class="form-control" dir="rtl" />
                            <span id="NameError" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button id="submitBtn" type="submit" class="btn btn-outline-success px-4">
                                <i class="bi bi-save"></i> حفظ
                            </button>
                            <a class="btn btn-outline-secondary px-4" asp-controller="Menegar" asp-action="ManagerMenegarClassView">
                                <i class="bi bi-arrow-left-circle"></i> عودة
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const id = "@idLectuer";
            console.log("id: "+id);
            if (!id) {
                $("#validationSummary").text("لم يتم تحديد الصف.");
                return;
            }


            function loadLectuerData() {
                $.when(
                    $.getJSON(`/api/lectuer/Edit?id=${id}`)
                ).done(function (lectuer) {
                    $('#Id').val(lectuer.idLectuer);
                    $('#Name').val(lectuer.nameLectuer);
                }).fail(function () {
                    $("#validationSummary").text("فشل في تحميل بيانات الصف .");
                });
            }

            loadLectuerData();

            function clearErrors() {
                $("#validationSummary").text("");
                $("#NameError").text("");
            }

            // ارسال التعديل
            $("#editLectuerForm").submit(function (e) {
                e.preventDefault();
                clearErrors();
                $("#submitBtn").prop("disabled", true);

                const data = {
                    idLectuer: $('#Id').val(),
                    nameLectuer: $("#Name").val()
                };

                $.ajax({
                    url: "/api/lectuer/Edit",
                    method: "Put",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (res) {
                        notifySuccess("تم الحفظ بنجاح");
                        setTimeout(() => {
                            window.location.href = "/Lectuer/LectuerView";
                        }, 1500);
                    }
                    ,
                    error: function (xhr) {
                        const errorMsg = xhr.responseJSON?.message || "حدث خطأ غير متوقع";
                        notifyError(errorMsg);
                        $("#submitBtn").prop("disabled", false);
                    }
                });
            });
        });
    </script>
}