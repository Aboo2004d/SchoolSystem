@model SchoolSystem.Data.Student

@{
    ViewData["Title"] = "إضافة طالب";
}

<h1 class="text-center mb-4">إضافة طالب جديد</h1>

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">
                <form id="createStudentForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label  class="form-label">اسم الطالب</label>
                            <input asp-for="Name" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الهوية</label>
                            <input asp-for="IdNumber" class="form-control" type="number" autocomplete="off" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم الجوال</label>
                            <input asp-for="Phone" class="form-control" type="tel" autocomplete="off" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الإيميل</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input asp-for="TheDate" class="form-control" type="date" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الصف</label>
                            <select asp-for="IdClass" class="form-control select2"></select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label  class="form-label">المدينة</label>
                            <input asp-for="City" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الحي</label>
                            <input asp-for="Area" class="form-control" />
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button id="submitBtn" type="submit" class="btn btn-outline-primary px-5">
                            <i class="bi bi-person-plus-fill"></i> إضافة
                        </button>
                        <a class="btn btn-outline-secondary px-4" asp-controller="Menegar" asp-action="ManagerMenegarStudentView">
                            <i class="bi bi-arrow-left-circle"></i> عودة
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $.getJSON("/api/theClass/GetClassToStudent", function (res) {
            const classes = res.theClasses || [];

            const select = $('#IdClass');
            select.empty();
            select.append('<option></option>');

            classes.forEach(c => {
                select.append(new Option(c.nameClass, c.idClass));
            });

            select.select2({
                placeholder: "اختر الصف...",
                allowClear: true,
                width: '100%'
            });
        }).fail(function () {
            notifyError("فشل في تحميل الصفوف.");
        });

        $("#createStudentForm").submit(function (e) {
            e.preventDefault(); 
            $("#submitBtn").prop("disabled", true);

            const data = {
                name: $("#Name").val(),
                idNumber: $("#IdNumber").val(),
                phone: $("#Phone").val(),
                email: $("#Email").val(),
                theDate: $("#TheDate").val(),
                idClass: $("#IdClass").val(),
                city: $("#City").val(),
                area: $("#Area").val()
            };

            $.ajax({
                url: "/api/student/Create",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                    notifySuccess("تم الحفظ بنجاح");

                    setTimeout(() => {
                        window.location.href = "/Menegar/ManagerMenegarStudentView";
                    }, 1500);
                },
                error: function (xhr) {
                    const errorMsg = xhr.responseJSON?.message || "حدث خطأ غير متوقع";
                    notifyError(errorMsg);
                    $("#submitBtn").prop("disabled", false);
                }
            });
        });
    </script>
}
