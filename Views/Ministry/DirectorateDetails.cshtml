@{ ViewData["Title"] = "تقرير المديرية"; }
<style>
    .ministry-report .report-card{border:0;border-radius:1rem;box-shadow:0 .25rem 1rem rgba(0,0,0,.08)}
    .ministry-report .metric-icon{width:2.75rem;height:2.75rem;display:inline-grid;place-items:center;border-radius:.8rem;font-size:1.25rem}
    .report-table-scroll{width:100%;overflow-x:auto;overflow-y:hidden;direction:rtl}.report-table-scroll table{min-width:950px;margin-bottom:0;white-space:nowrap}
</style>
<div class="container py-4 ministry-report" dir="rtl">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><a asp-action="Directorates" class="text-decoration-none"><i class="bi bi-arrow-right ms-1"></i>مديريات الوزارة</a><h1 class="h2 fw-bold mt-2 mb-1" id="directorateName">تقرير المديرية</h1><p class="text-muted mb-0">تقرير إشرافي مجمع على مستوى المديرية.</p></div><a class="btn btn-outline-secondary" asp-action="Directorates">عودة</a></div>
    <div id="loading" class="text-center py-5"><div class="spinner-border text-primary"></div><div class="text-muted mt-2">جارٍ إعداد التقرير...</div></div>
    <div id="content" class="d-none">
        <section class="card report-card mb-4"><div class="card-header bg-primary text-white"><h2 class="h5 mb-0"><i class="bi bi-diagram-3-fill ms-2"></i>بطاقة المديرية</h2></div><div class="card-body"><div class="row g-3" id="profile"></div></div></section>
        <div class="row g-3 mb-4" id="summary"></div>
        <section class="card report-card mb-4"><div class="card-header bg-light"><h2 class="h5 mb-0"><i class="bi bi-person-vcard-fill ms-2"></i>مسؤول المديرية</h2></div><div class="card-body"><div class="row g-3" id="manager"></div></div></section>
        <section class="card report-card overflow-hidden"><div class="card-header bg-light"><h2 class="h5 mb-0"><i class="bi bi-buildings-fill ms-2"></i>مدارس المديرية</h2></div><div class="report-table-scroll"><table class="table table-bordered table-hover align-middle"><thead class="table-light"><tr><th>#</th><th>المدرسة</th><th>المرحلة</th><th>المديرون</th><th>المعلمون</th><th>الطلاب</th><th>الصفوف</th><th>الحالة</th></tr></thead><tbody id="schools"></tbody></table></div></section>
    </div>
</div>
@section Scripts{
<script>
const id='@ViewBag.DirectorateId';const esc=value=>String(value??'-').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
(async()=>{try{const response=await fetch(`/api/ministry/directorates/${id}`);if(!response.ok){const e=await response.json().catch(()=>null);throw new Error(e?.message||'تعذر تحميل تقرير المديرية.')}const data=await response.json(),d=data.directorate;document.getElementById('directorateName').textContent=d.name;document.getElementById('profile').innerHTML=[['الكود',d.code],['الحالة',d.isActive?'فعالة':'معطلة'],['المدينة',d.city],['المنطقة',d.area],['الهاتف',d.phone],['البريد الإلكتروني',d.email]].map(x=>`<div class="col-6 col-lg-4"><div class="text-muted small">${x[0]}</div><div class="fw-bold mt-1">${esc(x[1])}</div></div>`).join('');const cards=[['المدارس',data.summary.schools,'bi-buildings-fill','primary'],['المدارس الفعالة',data.summary.activeSchools,'bi-building-check','success'],['مديرو المدارس',data.summary.managers,'bi-person-vcard','info'],['المعلمون',data.summary.teachers,'bi-person-badge','warning'],['الطلاب',data.summary.students,'bi-mortarboard','primary'],['الصفوف',data.summary.classes,'bi-columns-gap','success']];document.getElementById('summary').innerHTML=cards.map(x=>`<div class="col-6 col-lg-4"><article class="card report-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="metric-icon bg-${x[3]}-subtle text-${x[3]}"><i class="bi ${x[2]}"></i></span><div><div class="text-muted small">${x[0]}</div><div class="fs-3 fw-bold">${x[1]}</div></div></div></article></div>`).join('');const m=d.manager;document.getElementById('manager').innerHTML=m?[['الاسم',m.name],['البريد',m.email],['الهاتف',m.phone],['المدينة',m.city],['المنطقة',m.area],['الحساب',m.accountActive?'فعال':'غير فعال']].map(x=>`<div class="col-6 col-lg-4"><div class="text-muted small">${x[0]}</div><div class="fw-bold mt-1">${esc(x[1])}</div></div>`).join(''):'<div class="col-12 text-center text-muted py-3">لا يوجد مسؤول مرتبط بهذه المديرية</div>';document.getElementById('schools').innerHTML=data.schools.length?data.schools.map((x,i)=>`<tr><td>${i+1}</td><td class="fw-semibold">${esc(x.name)}</td><td>${esc(x.stage)}</td><td>${x.managers}</td><td>${x.teachers}</td><td>${x.students}</td><td>${x.classes}</td><td><span class="badge ${x.isActive?'bg-success':'bg-secondary'}">${x.isActive?'فعالة':'معطلة'}</span></td></tr>`).join(''):'<tr><td colspan="8" class="text-center text-muted py-4">لا توجد مدارس</td></tr>';document.getElementById('content').classList.remove('d-none')}catch(error){notifyError(error.message)}finally{document.getElementById('loading').classList.add('d-none')}})();
</script>}
