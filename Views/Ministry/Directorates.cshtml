@{ ViewData["Title"] = "مديريات الوزارة"; }
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<style>
    .ministry-table-scroll{width:100%;max-width:100%;overflow-x:auto;overflow-y:hidden;direction:rtl}.ministry-table-scroll.no-overflow{overflow-x:hidden}
    #directoratesTable{direction:rtl!important;min-width:1200px;width:100%!important}#directoratesTable th,#directoratesTable td{white-space:nowrap;text-align:right!important}
    table.dataTable thead>tr>th.sorting{padding-right:.75rem!important;padding-left:28px!important}table.dataTable thead>tr>th.sorting::before,table.dataTable thead>tr>th.sorting::after{right:auto!important;left:10px!important}
</style>
<div class="container py-4" dir="rtl">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><h1 class="mb-1">مديريات الوزارة</h1><p class="text-muted mb-0">الإشراف على المديريات ومسؤوليها ومؤشراتها.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-success" asp-action="CreateDirectorate"><i class="bi bi-diagram-3"></i> إضافة مديرية</a><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-right-circle"></i> لوحة الوزارة</a></div></div>
    <table id="directoratesTable" class="table table-bordered table-hover align-middle w-100"><thead class="table-light"><tr><th>الكود</th><th>المديرية</th><th>الموقع</th><th>المسؤول</th><th>المدارس</th><th>المدارس الفعالة</th><th>المعلمون</th><th>الطلاب</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody></tbody></table>
</div>
@section Scripts{
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script><script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
const token=()=>document.querySelector('input[name="__RequestVerificationToken"]').value;let table;
const escapeHtml=value=>String(value??'-').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
$(async function(){table=$('#directoratesTable').DataTable({data:[],pageLength:10,lengthMenu:[[5,10,25,50],[5,10,25,50]],order:[[1,'asc']],autoWidth:false,columns:[{data:'code',render:escapeHtml},{data:'name',render:x=>`<span class="fw-semibold">${escapeHtml(x)}</span>`},{data:null,render:x=>escapeHtml([x.city,x.area].filter(Boolean).join(' - ')||'-')},{data:'manager',render:escapeHtml},{data:'schools'},{data:'activeSchools'},{data:'teachers'},{data:'students'},{data:'isActive',render:x=>x?'<span class="badge bg-success">فعالة</span>':'<span class="badge bg-secondary">معطلة</span>'},{data:null,orderable:false,searchable:false,render:x=>`<div class="d-flex gap-1"><a class="btn btn-sm btn-outline-info" href="/Ministry/DirectorateDetails/${x.id}"><i class="bi bi-file-earmark-bar-graph"></i> التفاصيل</a><button class="btn btn-sm ${x.isActive?'btn-outline-warning':'btn-outline-success'} toggle-directorate" data-id="${x.id}" data-active="${!x.isActive}">${x.isActive?'تعطيل':'تفعيل'}</button></div>`}],language:{search:'بحث: 🔍',searchPlaceholder:'اسم المديرية أو الكود',lengthMenu:'عرض _MENU_ سجل',info:'عرض _START_ إلى _END_ من أصل _TOTAL_ سجل',infoEmpty:'لا توجد سجلات',zeroRecords:'لا توجد نتائج مطابقة',emptyTable:'لا توجد مديريات',paginate:{next:'التالي',previous:'السابق'}},dom:"<'row align-items-center mb-3'<'col-12 col-md-6'l><'col-12 col-md-6'f>>"+"<'row'<'col-12'tr>>"+"<'row align-items-center mt-3'<'col-12 col-md-5'i><'col-12 col-md-7'p>>"});$(table.table().node()).wrap('<div class="ministry-table-scroll"></div>');await loadRows()});
async function loadRows(){try{const response=await fetch('/api/ministry/directorates');if(!response.ok)throw new Error('تعذر تحميل المديريات.');table.clear().rows.add(await response.json()).draw(false);table.columns.adjust();requestAnimationFrame(()=>{const x=document.querySelector('.ministry-table-scroll');x.classList.toggle('no-overflow',x.scrollWidth<=x.clientWidth+1)})}catch(error){notifyError(error.message)}}
$('#directoratesTable').on('click','.toggle-directorate',async function(){this.disabled=true;try{const response=await fetch(`/api/ministry/directorates/${this.dataset.id}/activation`,{method:'PATCH',headers:{'Content-Type':'application/json','RequestVerificationToken':token()},body:JSON.stringify({isActive:this.dataset.active==='true'})});if(!response.ok)throw new Error('تعذر تحديث حالة المديرية.');notifySuccess('تم تحديث حالة المديرية بنجاح.');await loadRows()}catch(error){notifyError(error.message);this.disabled=false}});
</script>}
