@{
    ViewData["Title"] = ViewBag.FormTitle;
    var type = (string)ViewBag.RecordType;
    var returnAction = type == "directorate" ? "Directorates" : type == "school" ? "Schools" : type == "directorateManager" ? "DirectorateManagers" : type == "schoolManager" ? "SchoolManagers" : type == "teacher" ? "Teachers" : "Students";
}
<div class="container py-4" dir="rtl">
 <div class="d-flex justify-content-between align-items-center gap-3 mb-4"><div><h1 class="mb-1">@ViewBag.FormTitle</h1><p class="text-muted mb-0">سيتم ربط السجل تلقائيًا بالوزارة الحالية.</p></div><a class="btn btn-outline-secondary" asp-action="@returnAction"><i class="bi bi-arrow-right-circle"></i> عودة إلى الصفحة السابقة</a></div>
 <form id="createForm" class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
 @if (type == "directorate") {
  <div class="row g-3">
   <div class="col-md-6"><label class="form-label">رمز المديرية</label><input id="code" class="form-control" maxlength="30" placeholder="مثال: DIR-03" required></div>
   <div class="col-md-6"><label class="form-label">اسم المديرية</label><input id="name" class="form-control" maxlength="200" required></div>
   <div class="col-md-6"><label class="form-label">المدينة</label><input id="city" class="form-control" maxlength="100"></div>
   <div class="col-md-6"><label class="form-label">الحي/المنطقة</label><input id="area" class="form-control" maxlength="100"></div>
   <div class="col-md-6"><label class="form-label">الهاتف</label><input id="phone" type="tel" class="form-control" maxlength="30"></div>
   <div class="col-md-6"><label class="form-label">البريد الإلكتروني</label><input id="email" type="email" class="form-control" maxlength="256"></div>
  </div>
 } else if (type == "school") {
  <div class="row g-3"><div class="col-md-6"><label class="form-label">المديرية</label><select id="organizationId" class="form-select" required><option value="">اختر المديرية</option></select></div><div class="col-md-6"><label class="form-label">اسم المدرسة</label><input id="name" class="form-control" maxlength="200" required><div id="similarity" class="form-text"></div></div><div class="col-md-4"><label class="form-label">المرحلة</label><select id="stage" class="form-select"><option value="">—</option></select></div><div class="col-md-4"><label class="form-label">النوع</label><select id="gender" class="form-select"><option value="">—</option></select></div><div class="col-md-4"><label class="form-label">الحالة الرسمية</label><select id="status" class="form-select"><option value="">—</option></select></div><div class="col-md-6"><label class="form-label">أدنى صف</label><input id="minClass" type="number" min="1" max="12" class="form-control"></div><div class="col-md-6"><label class="form-label">أعلى صف</label><input id="maxClass" type="number" min="1" max="12" class="form-control"></div></div>
 } else {
  <div class="row g-3"><div class="col-md-6"><label class="form-label">الاسم الكامل</label><input id="name" class="form-control" maxlength="150" required></div><div class="col-md-6"><label class="form-label">رقم الهوية</label><input id="idNumber" class="form-control" pattern="[1-9][0-9]{8}" maxlength="9" required></div><div class="col-md-6"><label class="form-label">البريد الإلكتروني</label><input id="email" type="email" class="form-control" required></div><div class="col-md-6"><label class="form-label">الهاتف</label><input id="phone" class="form-control" required></div><div class="col-md-6"><label class="form-label">تاريخ الميلاد</label><input id="birthDate" type="date" class="form-control" required></div><div class="col-md-6"><label class="form-label">@(type == "directorateManager" ? "المديرية الشاغرة" : "المدرسة")</label><select id="organizationId" class="form-select" required><option value="">اختر</option></select></div><div class="col-md-6 @(type == "student" ? "" : "d-none")"><label class="form-label">الصف</label><select id="classId" class="form-select"><option value="">اختر المدرسة أولًا</option></select></div><div class="col-md-6"><label class="form-label">المدينة</label><input id="city" class="form-control" required></div><div class="col-md-6"><label class="form-label">الحي/المنطقة</label><input id="area" class="form-control" required></div></div>
 }
 </div><div class="card-footer bg-white border-0 p-4 pt-0"><button id="submitButton" class="btn btn-success"><i class="bi bi-plus-circle"></i> حفظ البيانات</button></div></form>
</div>
@section Scripts {
<script>
const type="@type", returnUrl="/Ministry/@returnAction", val=id=>document.getElementById(id)?.value?.trim()||"", esc=v=>String(v??"").replace(/[&<>\x27\x22]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\x27":"&#39;","\x22":"&quot;"}[c]));
async function options(id){const q=new URLSearchParams({type});if(id)q.set("organizationId",id);const r=await fetch(`/api/ministry/create-options?${q}`);if(!r.ok)throw new Error("تعذر تحميل خيارات النموذج.");return r.json()}
async function load(){if(type==="directorate")return;const o=await options();const select=document.getElementById("organizationId"),rows=type==="directorateManager"||type==="school"?o.directorates:o.schools;select.insertAdjacentHTML("beforeend",rows.map(x=>`<option value="${x.id}">${esc(x.name)}${x.directorate?` - ${esc(x.directorate)}`:""}</option>`).join(""));if(type==="school"){for(const [id,rows] of [["stage",o.stages],["gender",o.genders],["status",o.statuses]])document.getElementById(id).insertAdjacentHTML("beforeend",rows.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join(""))}}
load().catch(e=>notifyError(e.message));
document.getElementById("organizationId")?.addEventListener("change",async e=>{if(type!=="student")return;const o=e.target.value?await options(e.target.value):{classes:[]};document.getElementById("classId").innerHTML="<option value=\"\">اختر الصف</option>"+o.classes.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join("")});
let timer;document.getElementById("name").addEventListener("input",()=>{if(type!=="school")return;clearTimeout(timer);timer=setTimeout(async()=>{const d=val("organizationId"),n=val("name"),box=document.getElementById("similarity");if(!d||n.length<2){box.textContent="";return}const r=await fetch(`/api/ministry/school-name-similarity?directorateId=${d}&name=${encodeURIComponent(n)}`),x=await r.json();box.className=`form-text ${x.similarity>=85?"text-danger":"text-success"}`;box.textContent=x.similarity?`أقرب اسم: ${x.name} — نسبة التشابه ${x.similarity}٪`:"لا يوجد اسم مشابه داخل المديرية."},350)});
document.getElementById("createForm").addEventListener("submit",async e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const b=document.getElementById("submitButton");b.disabled=true;try{let endpoint,body;if(type==="directorate"){endpoint="/api/ministry/directorates";body={code:val("code"),name:val("name"),city:val("city")||null,area:val("area")||null,phone:val("phone")||null,email:val("email")||null}}else if(type==="school"){endpoint="/api/ministry/schools";body={directorateId:val("organizationId"),name:val("name"),idStage:val("stage")||null,idGender:val("gender")||null,idStatusSchool:val("status")||null,minClass:Number(val("minClass"))||null,maxClass:Number(val("maxClass"))||null}}else{endpoint=`/api/ministry/people/${type}`;body={organizationId:val("organizationId"),name:val("name"),idNumber:val("idNumber"),email:val("email"),phone:val("phone"),birthDate:val("birthDate"),city:val("city"),area:val("area"),classId:type==="student"?val("classId")||null:null}}const r=await fetch(endpoint,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});if(!r.ok){const x=await r.json().catch(()=>null);throw new Error(x?.message||Object.values(x?.errors||{}).flat()[0]||"تعذر حفظ البيانات.")}sessionStorage.setItem("ministryNotification","تمت الإضافة بنجاح.");location.href=returnUrl}catch(err){notifyError(err.message);b.disabled=false}});
</script>
}
