@{
    ViewData["Title"] = "الحضور والغياب";
}

<div class="container mt-3">
    <!-- العنوان وزر العودة -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap">
            <h4 class="mb-2">الحضور والغياب في الصف: @ViewBag.StdClass</h4>
            <a class="btn btn-outline-dark mb-2" asp-action="Index" asp-controller="Student">
                <i class="bi bi-arrow-left"></i> عودة
            </a>
        </div>
    </div>

    <hr>

    <!-- ملخص الحضور حسب المادة والمعلم -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle" id="attendancesTable">
            <thead class="table-dark">
                <tr>
                    <th>المادة</th>
                    <th>المعلم</th>
                    <th>أيام الحضور / الأيام الكلية</th>
                    <th>التفاصيل</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const idStudent = '@ViewBag.StdId';
            const role = '@ViewBag.Role';
            $('#attendancesTable').DataTable({
                "deferRender": true,
                "processing": true,
                "serverSide": true,
                "order": [[0, "asc"]],
                "ajax": {
                    "url": "/api/Attendance/student-summary?studentid=" + encodeURIComponent(idStudent),
                    "type": "GET",
                    "dataSrc": function (json) {
                            if (json.error) {
                                alert(json.error);

                                if (!json.status) {
                                    window.location.href = "/Account/Login";
                                } else {
                                    if (role === "Manager" || role === "Admin") {
                                        window.location.href = "/Menegar/Index";
                                    } else {
                                        window.location.href = "/Student/Index";
                                    }
                                }

                                return []; // توقف تحميل البيانات
                            }

                            return json.data; // في حال عدم وجود خطأ، أرجع البيانات للجدول
                        }
                },
                "columns": [
                    { "data": "lectuerName" },
                    { "data": "teacherName" },
                    {
                        "data": null,
                        "render": function (_, type, row) {
                            return `${row.attendanceDays} / ${row.totalDays}`;
                        }
                    },
                    {
                        "data": null,
                        "orderable": false,
                        "searchable": false,
                        "render": function (_, type, row) {
                            const url = '/Attendance/StudentAttendanceDetails'
                                + '?studentid=' + encodeURIComponent(idStudent)
                                + '&teacherId=' + encodeURIComponent(row.teacherId)
                                + '&lectuerId=' + encodeURIComponent(row.lectuerId);
                            return `<a class="btn btn-outline-info btn-sm" href="${url}">عرض التفاصيل</a>`;
                        }
                    }
                ],
                "language": {
                    "search": "🔍 بحث: ",
                    "lengthMenu": "عرض _MENU_ سجل",
                    "info": "عرض من _START_ إلى _END_ من أصل _TOTAL_ سجل",
                    "paginate": {
                        "next": "الصفحة التالية",
                        "previous": "الصفحة السابقة"
                    },
                    "zeroRecords": "لم يتم العثور على سجلات"
                }
            });
        });
    </script>

    <!-- تحسينات CSS -->
    <style>
        body {
            font-size: 14px;
            direction: rtl;
            text-align: right;
        }

        @@media (max-width: 768px) {
            h4 {
                font-size: 16px;
            }

            table {
                font-size: 12px;
                overflow-x: auto;
                display: block;
                width: 100%;
            }

            .btn {
                font-size: 12px !important;
                padding: 6px 10px !important;
            }

            th, td {
                white-space: nowrap;
            }
        }
    </style>
}
