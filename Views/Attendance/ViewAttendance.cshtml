@model SchoolSystem.Data.Attendance
@{
    ViewData["Title"] = "الحضور و الغياب";
}
<link rel="stylesheet" href="https://cdn.datatables.net/2.2.1/css/dataTables.bootstrap5.css" />

<h1>متابعة الحضور والغياب للطلاب</h1>
<div class="dropdown">
    <button class="btn btn-outline-success dropdown-toggle" type="button" id="dropdownNewMark" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-plus-circle"></i> تسجيل الحضور و الغياب 
    </button>
    <ul class="dropdown-menu p-3" aria-labelledby="dropdownNewMark" style="min-width: 250px;">
        <li class="form-group mb-2">
            <label for="subjectDropdown">اختر المادة</label>
            <select id="subjectDropdown" class="form-control">
                <option value="">يرجى الاختيار...</option>
                <!-- خيارات المواد هنا -->
            </select>
        </li>
        <li class="form-group">
            <label for="gradeDropdown">اختر الصف</label>
            <select id="gradeDropdown" class="form-control">
                <option value="">يرجى الاختيار...</option>
                <!-- خيارات الصفوف هنا -->
            </select>
        </li>
    </ul>
    <a class="btn btn-outline-dark" asp-controller="Teacher" asp-action="Index"><i class="bi bi-arrow-left"></i> عودة</a>
</div>

<hr>
<div class="table-responsive attendance-table-container" dir="rtl">
<table id="studentsTable" class="table table-bordered table-hover display nowrap" style="width:100%">
    <thead>
        <tr>
            <th>
                الاسم الطالب
            </th>
            <th>
                الصف
            </th>
            <th>
                المادة
            </th>
            <th>
                الحالة
            </th>
            <th>
                التاريخ
            </th>
            <th>
                العذر
            </th>
            <th>
                الخيارات
            </th>
        </tr>
    </thead>
</table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const idTeacher = "@ViewBag.IdTeacher";
            console.log("Teacher ID: " + idTeacher); // للتأكد من أن المعرف يتم تمريره بشكل صحيح
            $('#studentsTable').DataTable({
                "deferRender": true,
                "processing": true,
                "serverSide": true,
                "paging": true,
                "pageLength": 10,
                "lengthMenu": [10, 25, 50, 100],
                "order": [[4, "desc"]],
                "ajax": {
                    "url": "/api/Attendance/teacher-records?teacherId=" + encodeURIComponent(idTeacher),
                    "type": "GET",
                    "dataSrc": function (json) {
                            if (json.error) {
                                alert(json.error);

                                if (!json.status) {
                                    window.location.href = "/Account/Login";
                                } else {
                                    window.location.href = "/Teacher/Index";
                                }

                                return []; // توقف تحميل البيانات
                            }

                            return json.data; // في حال عدم وجود خطأ، أرجع البيانات للجدول
                        }
                },
                "columns": [
                    { "data": "studentName"},
                    { "data": "classroomName"},
                    { "data": "lectuerName"},
                    { 
                        "data": "attendanceStatus",
                            "render": function (data, type, row) {
                                if(data == '1')
                                {
                                    return "حضور";
                                }else if (data == '0')
                                {
                                    return "غياب";
                                }else if(data == 'm')
                                {
                                    return "غياب بعذر";
                                }
                                else
                                {
                                    return "قيمة غير صالحة";
                                }
                            }
                    },
                    { "data": "dateAndTime"},
                    { "data": "excuse"},
                   {
                         "data": null,
                         "orderable": false,
                         "searchable": false,
                        "render": function (data, type, row) {
                                return`<a class="btn btn-outline-warning" href="/Attendance/Edit/${row.id}">تعديل</a>`;
                            
                        }
                    }
                ],
                "language": {
                    "search": "🔍بحث: ",
                    "lengthMenu": "عرض _MENU_ سجل",
                    "info": "عرض من  _START_ الى _END_ من اصل _TOTAL_ سجل",
                    "paginate": {
                        "next": "الصفحة التالية",
                        "previous": "الصفحة السابقة"
                    },
                    "zeroRecords": "لم يتم العثور على سجلات"
                },
                "dom":
                    "<'row align-items-center mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row align-items-center mt-3 mb-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
    
    <script>
        $(function () {
            const teacherId = "@ViewBag.IdTeacher";
            var gradeId = null; // متغير لتخزين id الصف
            var subjectId = null; // متغير لتخزين id المادة
            // عند فتح القائمة (Bootstrap Dropdown)
            $('#dropdownNewMark').on('click', function () {
                // تحميل المواد عند أول مرة فقط (يمكنك تحسينه لاحقاً للتحميل مرة واحدة فقط)
                $.getJSON('/api/Attendance/subjects', { teacherId: teacherId }, function (data) {
                    var subjectDropdown = $('#subjectDropdown');
                    subjectDropdown.empty().append('<option value="">يرجى الاختيار...</option>');

                    $.each(data, function (i, subject) {
                        subjectDropdown.append($('<option>').val(subject.id).text(subject.name));
                    });
                });
            });

            // عند اختيار مادة
            $('#subjectDropdown').change(function () {
                subjectId = $(this).val();
                if (!subjectId) return;

                $.getJSON('/api/Attendance/classes', { teacherId: teacherId, subjectId: subjectId }, function (data) {
                    var gradeDropdown = $('#gradeDropdown');
                    gradeDropdown.empty().append('<option value="">يرجى الاختيار...</option>');

                    $.each(data, function (i, grade) {
                        gradeDropdown.append($('<option>').val(grade.id).text(grade.name));
                    });

                    $('#gradeContainer').show();
                });
            });

            // عند اختيار الصف
            $('#gradeDropdown').change(function () {
                gradeId = $(this).val();
                subjectId = $('#subjectDropdown').val();

                if (gradeId && subjectId) {
                    // الانتقال إلى صفحة الإنشاء مع القيم
                    window.location.href = `/Attendance/Create?idTeacher=${teacherId}&idLectuer=${subjectId}&idClass=${gradeId}`;
                    @*@Console.WriteLine($"Redirecting to /Attendance/Create?idTeacher={teacherId}&idLectuer={subjectId}&idClass={gradeId}");*@
                    console.log(`/Attendance/Create?idTeacher=${teacherId}&idLectuer=${subjectId}&idClass=${gradeId}`);
                }
            });
        });
    </script>
    <style>
        .dropdown-menu select {
            width: 100%;
        }

        .attendance-table-container {
            margin-bottom: 1rem;
        }

        #studentsTable_wrapper {
            padding-bottom: 4.5rem;
            direction: rtl;
            text-align: right;
        }

        #studentsTable th,
        #studentsTable td {
            text-align: right !important;
        }

        #studentsTable_wrapper .dt-search,
        #studentsTable_wrapper .dataTables_filter {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            gap: .5rem;
            direction: rtl;
            text-align: right !important;
        }

        #studentsTable_wrapper .dt-search input,
        #studentsTable_wrapper .dataTables_filter input {
            margin: 0;
            text-align: right;
            direction: rtl;
            max-width: 260px;
        }

        #studentsTable_wrapper .dt-length,
        #studentsTable_wrapper .dataTables_length,
        #studentsTable_wrapper .dt-info,
        #studentsTable_wrapper .dataTables_info {
            text-align: right !important;
        }

        #studentsTable_wrapper .dataTables_paginate {
            float: none;
            display: flex;
            justify-content: flex-end;
        }

        #studentsTable_wrapper .pagination {
            margin-bottom: 0;
            flex-wrap: wrap;
        }

        @@media (max-width: 767.98px) {
            #studentsTable_wrapper .dataTables_paginate {
                justify-content: center;
                margin-top: .75rem;
            }

            #studentsTable_wrapper .dataTables_info {
                text-align: center;
            }
        }
        /* العرض المضغوط: افتراضي لجميع الأجهزة */
        body {
            font-size: 10px;
        }

        /* إذا كان العرض أكبر من 768px (كمبيوتر أو لابتوب) */
        @@media (min-width: 768px) {
            body {
                font-size: 16px; /* حجم الخط الطبيعي */
            }

            table thead, table tbody {
                font-size: 14px;
            }

            .btn {
                font-size: 14px !important;
                padding: 6px 12px !important;
                height: auto !important;
                min-width: auto !important;
            }

            /* أي عناصر أخرى تم تصغيرها يمكن تعديلها هنا */
        }

    </style>
}
