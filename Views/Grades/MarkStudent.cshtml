@model SchoolSystem.Data.Grade
@using SchoolSystem.Data

@{
    ViewData["Title"] = "علاماتي";
}

<div class="container mt-3">
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap">
            <h4 class="mb-2">علامات الطالب: @ViewBag.name</h4>
            @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Manager))
            {
                <a class="btn btn-outline-dark mb-2" asp-action="ManagerMenegarStudentView" asp-controller="Menegar">
                    <i class="bi bi-arrow-left"></i> عودة
                </a>
            }
            else
            {
                <a class="btn btn-outline-dark mb-2" asp-action="Index" asp-controller="Student" asp-route-StudentId="@ViewBag.IdStudent">
                    <i class="bi bi-arrow-left"></i> عودة
                </a>
            }
        </div>
    </div>

    <hr />

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle" id="studentsTable">
            <thead class="table-dark">
                <tr>
                    <th>المادة</th>
                    <th>الشهر الأول</th>
                    <th>النصفي</th>
                    <th>الشهر الثاني</th>
                    <th>النشاط</th>
                    <th>النهائي</th>
                    <th>المجموع</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            const idStudent = '@ViewBag.IdStudent';
            const role = '@(User.IsInRole(RoleNames.Admin) ? RoleNames.Admin : User.IsInRole(RoleNames.Manager) ? RoleNames.Manager : RoleNames.Student)';
            $('#studentsTable').DataTable({
                "deferRender": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/api/Grades/student-records?studentid=" + encodeURIComponent(idStudent),
                    "type": "GET",
                    "dataSrc": function (json) {
                        if (json.error) {
                            alert(json.error);

                            if (!json.status) {
                                window.location.href = "/Account/Login";
                            } else {
                                if (role === "Manager" || role === "Admin") {
                                    window.location.href = "/Menegar/Index";
                                } else {
                                    window.location.href = "/Student/Index";
                                }
                            }

                            return [];
                        }

                        return json.data;
                    }
                },
                columns: [
                    { data: "lectuerName" },
                    { data: "firstMonth" },
                    { data: "mid" },
                    { data: "secondMonth" },
                    { data: "activity" },
                    { data: "final" },
                    { data: "total" },
                ],
                "language": {
                    "search": "🔍 بحث: ",
                    "lengthMenu": "عرض _MENU_ سجل",
                    "info": "عرض من _START_ إلى _END_ من أصل _TOTAL_ سجل",
                    "paginate": {
                        "next": "الصفحة التالية",
                        "previous": "الصفحة السابقة"
                    },
                    "zeroRecords": "لم يتم العثور على سجلات"
                }
            });
        });
    </script>

    <style>
        body {
            font-size: 14px;
            direction: rtl;
            text-align: right;
        }

        @@media (max-width: 768px) {
            h4 {
                font-size: 16px;
            }

            table {
                font-size: 12px;
                overflow-x: auto;
                display: block;
                width: 100%;
            }

            .btn {
                font-size: 12px !important;
                padding: 6px 10px !important;
            }

            th, td {
                white-space: nowrap;
            }
        }
    </style>
}
