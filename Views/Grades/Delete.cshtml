@model SchoolSystem.Data.Grade

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Grade</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstMonth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstMonth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mid)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Mid)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SecondMonth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SecondMonth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Activity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Activity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Final)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Final)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Total)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Total)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdLectuerNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdLectuerNavigation.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdStudentNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdStudentNavigation.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdTeacherNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdTeacherNavigation.Id)
        </dd>
    </dl>
    
    <form id="gradeDeleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="GradesId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
<script>
    document.getElementById('gradeDeleteForm').addEventListener('submit', async function (event) {
        event.preventDefault();
        const response = await fetch('/api/Grades/records/@Model.GradesId', {
            method: 'DELETE',
            credentials: 'same-origin',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) return alert(result.message || 'فشل حذف سجل العلامات.');
        window.location.href = result.redirectUrl;
    });
</script>
