@model SchoolSystem.Models.GradeInputViewModel
@using SchoolSystem.Data;
@{
    ViewData["Title"] = "انشاء العلامات";
}

<h4>اضافة العلامات للطلاب في الصف: @ViewBag.GradeName في مادة: @ViewBag.SubjectName</h4>
<hr />
<form id="gradesForm">
@Html.AntiForgeryToken()
<table class="table" id="gradesTable">
    <thead>
        <tr style="font-size: smaller;">
            <th >اسم الطالب</th>
            <th>الشهر الاول</th>
            <th>النصفي</th>
            <th>الشهر الثاني</th>
            <th>النشاط</th>
            <th>النهائي</th>
        </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < ViewBag.StudentsWithGrades.Count; i++)
    {
        var item = ViewBag.StudentsWithGrades[i];
        var student = item.Student;
        var grade = item.Grade ?? new Grade();

        <tr>
            <td style="font-size: smaller;">
                 @{
                    var fullname = student.Name.Split(' ');
                    int nameLength = fullname.Length;
                    var firstName = fullname[0];
                    var lastName = fullname[nameLength - 1];
                    if(fullname.Length > 1){
                        lastName = fullname[nameLength - 1];
                        <p>@fullname[0] @fullname[1] @fullname[nameLength - 1]</p> 
                    }else{
                        @firstName
                    }
                }
                <input type="hidden" name="Grades[@i].StudentId" value="@grade.IdStudent" />
                <input type="hidden" name="Grades[@i].TeacherId" value="@grade.IdTeacher" />
                <input type="hidden" name="Grades[@i].LectuerId" value="@grade.IdLectuer" />
                <input type="hidden" name="Grades[@i].ClassId" value="@grade.IdClass" />
            </td>
            <td><input type="number" class="form-control small-input" name="Grades[@i].FirstMonth" value="@(grade.FirstMonth )" /></td>
            <td><input type="number" class="form-control small-input" name="Grades[@i].Mid" value="@(grade.Mid )" /></td>
            <td><input type="number" class="form-control small-input" name="Grades[@i].SecondMonth" value="@(grade.SecondMonth )" /></td>
            <td><input type="number" class="form-control small-input" name="Grades[@i].Activity" value="@(grade.Activity)" /></td>
            <td><input type="number" class="form-control small-input" name="Grades[@i].Final" value="@(grade.Final )" /></td>
        </tr>
    }


    </tbody>
</table>


<div>
    <button type="submit" class="btn btn-success" id="saveAllBtn">حفظ</button>
    <a class="btn btn-dark" asp-action="ViewGrades" asp-route-teacherId="@ViewBag.TeacherId">عودة دون حفظ</a>
</div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#gradesTable').DataTable({
                paging: false,
                searching: true,
                info: true,
                lengthChange: false,
                ordering: true,
                language: {
                    "search": "🔍بحث: ",
                    "info": "عرض من  _START_ الى _END_ من اصل _TOTAL_ سجل",
                    "zeroRecords": "لم يتم العثور على سجلات"
                },
                dom:
                "<'row mb-3'<'col-sm-12 text-end'f>>" +        // البحث فقط في اليمين
                "<'row'<'col-sm-12'tr>>" +                     // الجدول
                "<'row mt-3'<'col-sm-6 text-start'i>>" // المعلومات يسار والترقيم يمين
            });
        });
    </script>
    <script>
        $('#gradesForm').on('submit', async function (event) {
            event.preventDefault();
            const button = $('#saveAllBtn');
            button.prop('disabled', true);

            const numberOrNull = value => value === '' ? null : Number(value);
            const payload = {
                teacherId: '@ViewBag.TeacherId',
                lectuerId: '@ViewBag.SubjectId',
                classId: '@ViewBag.ClassId',
                items: $('#gradesTable tbody tr').map(function () {
                    return {
                        studentId: $(this).find('input[name$=".StudentId"]').val(),
                        firstMonth: numberOrNull($(this).find('input[name$=".FirstMonth"]').val()),
                        mid: numberOrNull($(this).find('input[name$=".Mid"]').val()),
                        secondMonth: numberOrNull($(this).find('input[name$=".SecondMonth"]').val()),
                        activity: numberOrNull($(this).find('input[name$=".Activity"]').val()),
                        final: numberOrNull($(this).find('input[name$=".Final"]').val())
                    };
                }).get()
            };

            try {
                const response = await fetch('/api/Grades/records', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(payload)
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    const validationMessage = result.errors
                        ? Object.values(result.errors).flat().join('\n')
                        : result.message;
                    throw new Error(validationMessage || 'فشل حفظ العلامات.');
                }
                window.location.href = result.redirectUrl;
            } catch (error) {
                alert(error.message);
                button.prop('disabled', false);
            }
        });
    </script>

    <style>
        .small-input {
            max-width: 80px;
            padding: 4px;
        }
        #gradesTable td, #gradesTable th {
            font-size: large;
        }
        
    </style>

}
