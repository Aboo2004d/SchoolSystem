@{
    ViewData["Title"] = "المعلمين";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">


<h2 class="mt-4 mb-3">👨‍🏫 معلمو المدرسة</h2>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-success" asp-controller="Teacher" asp-action="Create">
        <i class="bi bi-person-plus-fill"></i> إضافة معلم
    </a>

    <button id="exportBtn" class="btn btn-outline-success"><i class="bi bi-file-earmark-arrow-up"></i> تصدير المعلمين</button>
    
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left-circle"></i> عودة
    </a>
</div>

<hr>

<div class="table-responsive">
    <table id="teachersTable" class="table table-bordered table-hover display" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>الاسم</th>
                <th class="d-none d-sm-table-cell">الإيميل</th>
                <th>الهاتف</th>
            </tr>
        </thead>
    </table>
</div>


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    <script>
        $(document).ready(function () {
            $('#teachersTable').DataTable({
                processing: true,
                serverSide: true,
                "ajax": {
                    "url": "/api/menegar/MenegarTeacher",
                    "type": "GET",
                    "dataSrc": function (json) {
                        if (json.error) {
                            if(!json.status){
                                alert(json.error);
                            window.location.href = "/Account/Login";
                            }
                            alert(json.error);
                            window.location.href = "/Menegar/Index";
                            return [];
                        }
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: "nameTeacher",
                        "render": function (data, type, row) {
                            const parts = data.trim().split(" ");
                            const displayName = parts.length === 1
                                ? parts[0]
                                : parts[0] + " " + parts[parts.length - 1];

                            return `
                                <span class="toggle-options" data-id="${row.idTeacher}">${displayName}</span>
                                <div class="options-container d-none" id="options-${row.idTeacher}">
                                    <ul class="list-unstyled m-0 p-2 bg-light border rounded">
                                        <li>
                                            <a class="dropdown-item details-btn text-end" 
                                            href="/Teacher/Details?id=${row.idTeacher}">
                                            <i class="fa fa-eye me-1"></i> تفاصيل
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider custom-divider" /></li>
                                        <li>
                                            <a class="dropdown-item details-btn text-warning fw-bold text-end" 
                                            href="/Teacher/ManagementClassLectuerForTeachers?idTeacher=${row.idTeacher}">
                                            <i class="fa fa-cogs me-1"></i> إدارة
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider custom-divider" /></li>
                                        <li>
                                            <a class="dropdown-item delete-btn text-end delete" data-id="${row.idTeacher}">
                                                <i class="fa fa-trash me-1"></i> حذف 
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            `;
                        }
                    },
                    {
                        data: "emailAddressTeacher",
                        createdCell: function (td) {
                            $(td).addClass('d-none d-sm-table-cell');
                        },
                        render: function (data) {
                            // تقسيم النص حسب @@
                            const parts = data.trim().split("@@");

                            // الجزء الأول قبل @@ (عادة الإيميل)
                            const parts1 = parts[0].trim().split(".");
                            const firstPart = parts1[0].substring(0, 3); // أول 3 أحرف

                            // الجزء الثاني بعد @@ (عادة دومين)
                            const parts2 = parts[1].trim().split(".");
                            const lastDomain = parts2[parts2.length - 1]; // آخر دومين

                            return `${firstPart}***@@***${lastDomain}`;
                        }
                    },
                    { data: "phoneTeacher" }
                ],
                language: {
                    search: "بحث: 🔍",
                    lengthMenu: "عرض _MENU_ سجل",
                    info: "عرض _START_ إلى _END_ من أصل _TOTAL_ سجل",
                    paginate: {
                        next: "التالي",
                        previous: "السابق"
                    },
                    zeroRecords: "لم يتم العثور على سجلات"
                },
                responsive: true,
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });

        $(function () {
            $(document).on('click', '.delete', function (e) {
                e.preventDefault();
                var btn = $(this);
                var id = btn.data('id');

                Swal.fire({
                    title: "هل أنت متأكد من الحذف؟",
                    text: "انت على وشك القيام بهذه العملية! هذا الإجراء لا يمكن التراجع عنه.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "نعم، متأكد",
                    cancelButtonText: "إلغاء"
                }).then((result) => {
                    if (result.isConfirmed) {
                        const data = {id: id};
                        $.ajax({
                            url: '/api/teacher/Delete',
                            method: "DELETE",
                            contentType: "application/json",
                            data: JSON.stringify(data),
                            success: function () {
                                notifySuccess("تم حذف الطالب بنجاح");
                                $('#teachersTable').DataTable().ajax.reload();
                            },
                            error: function () {
                                notifyError("فشلت عملية الحذف");
                            }
                        });
                    }
                });

            });
        });
    </script>

    <script>
        $(document).on("click", ".toggle-options", function (e) {
            e.stopPropagation(); // منع انتشار الحدث لمنع إغلاق فوري للقائمة

            var id = $(this).data("id");
            var target = $("#options-" + id);

            // إذا كانت هذه القائمة مفتوحة، نغلقها
            if (!target.hasClass("d-none")) {
                target.addClass("d-none");
            } else {
                // إغلاق كل القوائم الأخرى
                $(".options-container").addClass("d-none");

                // فتح القائمة الحالية
                target.removeClass("d-none");
            }
        });

        // إغلاق القائمة عند النقر خارجها
        $(document).on("click", function () {
            $(".options-container").addClass("d-none");
        });

        // منع إغلاق القائمة إذا تم النقر داخل القائمة نفسها
        $(document).on("click", ".options-container", function (e) {
            e.stopPropagation();
        });
    </script>
    
    <script>
        document.getElementById('exportBtn').addEventListener('click', function () {
            // عرض إشعار (من خلال Toastify أو Notyf أو SweetAlert)
            Toastify({
                text: "جارٍ تصدير الملف...",
                duration: 3000,
                gravity: "top",
                position: "center",
                backgroundColor: "#28a745"
            }).showToast();

            // بدء التحميل بعد لحظات
            setTimeout(function () {
                window.location.href = '@Url.Action("ExportAllTeacherInSchoolToExcel", "ExportData")';
            }, 1000); // تأخير بسيط لعرض الإشعار
        });
    </script>

    <style>
        .delete-btn {
            display: block;
            padding: 8px 16px;
            color: #dc3545; /* أحمر Bootstrap */
            border: 1px solid #dc3545;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            background-color: #fff;
            font-weight: 500;
        }

        .delete-btn:hover {
            background-color: #dc3545;
            color: #fff;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.2);
        }

        .delete-btn:active {
            transform: scale(0.98);
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2) inset;
        }

        .details-btn {
            display: block;
            padding: 8px 16px;
            color: #0d6efd; /* أزرق Bootstrap */
            border: 1px solid #0d6efd;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            background-color: #fff;
            font-weight: 500;
        }

        .details-btn:hover {
            background-color: #0d6efd;
            color: #fff;
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
        }

        .details-btn:active {
            transform: scale(0.98);
            box-shadow: 0 2px 4px rgba(13, 110, 253, 0.2) inset;
        }

        .dropdown-item.text-warning:hover {
            background-color: #fff3cd; /* لون فاتح يشبه التحذير/الإدارة */
            color: #856404;

        }
        .custom-divider {
            border: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, #ccc, transparent);
            margin: 8px 0;
        }
        .custom-details-btn {
            color: #ffc107; /* النص أبيض */
            border-color: #ffc107; /* لون حدود الزر - أصفر */
            background-color: transparent;
            transition: 0.3s ease-in-out;
        }

        .custom-details-btn:hover {
            background-color: #ffc107; /* خلفية الزر تصبح صفراء عند الهوفر */
            color: #fff; /* النص يبقى أبيض */
        }

        body {
            font-family: 'Tahoma', 'Arial', sans-serif;
        }

        #teachersTable thead th {
            background-color: #f8f9fa;
            font-weight: bold;
            text-align: right;
            padding: 12px 15px;
        }

        #teachersTable tbody td {
            padding: 10px 15px;
            vertical-align: middle;
        }

        .dataTables_filter input {
            margin-right: 10px;
        }

        .dataTables_wrapper .row:first-child {
            margin-bottom: 15px;
        }
    </style>
}
