@{
    ViewData["Title"] = "الصفوف";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

<h2 class="mt-4 mb-3">🏫 إدارة الصفوف</h2>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-success" asp-controller="TheClass" asp-action="Create">
        <i class="bi bi-plus-circle"></i> إنشاء صف جديد
    </a>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left-circle"></i> عودة
    </a>
</div>

<hr />

<div class="table-responsive">
    <table id="classesTable" class="table table-bordered table-hover display nowrap" style="width:100%">
        <thead class="table-light">
            <tr>
                <th>الصف</th>
                <th>الطلاب</th>
                <th>المعلمين</th>
            </tr>
        </thead>
    </table>
</div>

<form asp-controller="TheClass" asp-action="Delete" method="post" id="DeleteClassForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" id="classId" />
</form>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#classesTable').DataTable({
                "responsive": true,
                "processing": true,
                "serverSide": true,
                "deferRender": true,
                "ajax": {
                    "url": "/api/menegar/MenegarClass",
                    "method": "GET",
                    "dataSrc": function (json) {
                        if (json.error) {
                            if(!json.status){
                                alert(json.error);
                                window.location.href = "/Account/Login";
                            }
                            alert(json.error);
                            window.location.href = "/Menegar/Index";
                            return [];
                        }
                        return json.data;
                    }
                },
                columns: [
                    { 
                        data: "nameClass",
                        render: function (data, type, row, meta) {
                            return `<span class="toggle-options" data-id="${row.idClass}">${data}</span>
                                    <div class="options-container d-none" id="options-${row.idClass}">
                                        <ul class="list-unstyled m-0 p-2 bg-light border rounded">
                                        <a class="dropdown-item edit-btn text-end" 
                                            href="/TheClass/Edit/${row.idClass}">
                                            <i class="bi bi-pencil-fill"></i> تعديل
                                            </a>
                                            <li><hr class="dropdown-divider custom-divider" /></li>
                                            <li><a class="dropdown-item delete-btn text-end text-danger delete" data-id="${row.idClass}">
                                            <i class="fa fa-trash me-1"></i> حذف</a></li>
                                        </ul>
                                    </div>`;
                        }
                    },
                    { data: "numberOfStudents",
                        render: function (data, type, row, meta) {
                            return `<a class="btn btn-outline-primary" href="/Menegar/ManagerMenegarStudentInClassView?idClass=${row.idClass}">${data} 👨‍🎓</a> `;
                        } },
                    { data: "numberOfTeachers",
                        render: function (data, type, row, meta) {
                            return `<a class="btn btn-outline-success" href="/Menegar/ManagerMenegarTeacherInClassView?idClass=${row.idClass}">${data} 👩‍🏫</a> `;
                        } }
                    
                ],
                language: {
                    search: "بحث: 🔍",
                    lengthMenu: "عرض _MENU_ صف",
                    info: "عرض من _START_ إلى _END_ من أصل _TOTAL_ صف",
                    paginate: {
                        next: "التالي",
                        previous: "السابق"
                    },
                    zeroRecords: "لا توجد بيانات لعرضها"
                },
                dom:
                    "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });

        // التعامل مع الحذف
        $(document).on("click", ".delete", function (e) {
            e.preventDefault();
            const classId = $(this).data("id");

            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: "لن تتمكن من التراجع بعد الحذف!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'نعم، احذفه!',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                        const data = {id: classId};
                        $.ajax({
                            url: '/api/theClass/Delete',
                            method: "DELETE",
                            contentType: "application/json",
                            data: JSON.stringify(data),
                            success: function () {
                                notifySuccess("تم حذف الصف بنجاح");
                                $('#classesTable').DataTable().ajax.reload();
                            },
                            error: function () {
                                notifyError("فشلت عملية الحذف");
                            }
                        });
                    }
            });
        });
    </script>
    <script>
        $(document).on("click", ".toggle-options", function (e) {
            e.stopPropagation(); // منع انتشار الحدث لمنع إغلاق فوري للقائمة

            var id = $(this).data("id");
            var target = $("#options-" + id);

            // إذا كانت هذه القائمة مفتوحة، نغلقها
            if (!target.hasClass("d-none")) {
                target.addClass("d-none");
            } else {
                // إغلاق كل القوائم الأخرى
                $(".options-container").addClass("d-none");

                // فتح القائمة الحالية
                target.removeClass("d-none");
            }
        });

        // إغلاق القائمة عند النقر خارجها
        $(document).on("click", function () {
            $(".options-container").addClass("d-none");
        });

        // منع إغلاق القائمة إذا تم النقر داخل القائمة نفسها
        $(document).on("click", ".options-container", function (e) {
            e.stopPropagation();
        });
    </script>

    <style>
        
        .delete-btn {
            
            display: block;
            padding: 8px 16px;
            color: #dc3545; /* أحمر Bootstrap */
            border: 1px solid #dc3545;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            background-color: #fff;
            font-weight: 500;
        }

        .delete-btn:hover {
            background-color: #dc3545;
            color: #ffffff !important;
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.2);
        }

        .delete-btn:active {
            transform: scale(0.98);
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2) inset;
        }
        
        .edit-btn {
            display: block;
            padding: 8px 16px;
            color: #fded0d; /* أزرق Bootstrap */
            border: 1px solid #fded0d;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            background-color: #fff;
            font-weight: 500;
        }

        .edit-btn:hover {
            background-color: #fded0d;
            color: #000000;
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
        }

        .edit-btn:active {
            transform: scale(0.98);
            box-shadow: 0 2px 4px rgba(13, 110, 253, 0.2) inset;
        }
        .custom-divider {
            border: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, #ccc, transparent);
            margin: 8px 0;
        }


    /* تنسيق عام للعناصر */
    body {
        font-family: 'Tahoma', 'Arial', sans-serif;
    }
    
    /* تنسيق الجدول */
    #classesTable {
        text-align: right;
        width: 100%;
        overflow-x: auto;
    }

    /* تنسيق رأس الجدول */
    #classesTable thead th {
        background-color: #f8f9fa;
        font-weight: bold;
        text-align: right;
        padding: 12px 10px;
    }
    
    /* تنسيق خلايا الجدول */
    #classesTable tbody td {
        padding: 5px 5x;
        vertical-align: middle;
        font-size: 16px;
    }
    
    /* تنسيق أزرار الإجراءات */
    .dropdown-menu {
        min-width: 150px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    
    /* تنسيق الزر الرئيسي */
    .btn-outline-success, .btn-outline-secondary {
        padding: 8px 15px;
        font-weight: 500;
    }
    
    /* تنسيق عناصر البحث */
    .dataTables_filter input {
        margin-right: 10px;
        margin-left: 0;
    }
    
    /* تعديل موقع عناصر التحكم في الجدول */
    .dataTables_wrapper .row:first-child {
        margin-bottom: 15px;
    }
    </style>


}
