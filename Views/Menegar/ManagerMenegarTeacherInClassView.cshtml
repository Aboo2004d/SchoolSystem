@{
    ViewData["Title"] = "ادارة المعلمين للصف";
    string id = ViewBag.IdClass;
}
<!-- تضمين Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<h1>ادارة المعلمين في الصف: @ViewBag.name</h1>

<p>
    <a class="btn btn-outline-dark" asp-controller="Menegar" asp-action="ManagerMenegarClassView">
        <i class="bi bi-arrow-left-circle"></i> عودة
    </a>
</p>

<hr>

<table id="teachersInClassTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>المعلم</th>
            <th>المادة</th>
        </tr>
    </thead>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js" defer></script>
    <script>
        var idClass = "@id";

        $(document).ready(function () {
            $('#teachersInClassTable').DataTable({
                "deferRender": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/api/menegar/MenegarTeacherInClass?idClass=" + idClass,
                    "type": "GET",
                    "dataSrc": function (json) {
                        if (json.error) {
                            if(!json.status){
                                alert(json.error);
                            window.location.href = "/Account/Login";
                            }
                            alert(json.error);
                            window.location.href = "/Menegar/Index";
                            return [];
                        }
                        return json.data;
                    }
                },
                "columns": [
                    { "data": "teacherName" },
                    { "data": "lectuerName" }
                ],
                "language": {
                    "search": "🔍بحث: ",
                    "lengthMenu": "عرض _MENU_ سجل",
                    "info": "عرض من  _START_ الى _END_ من اصل _TOTAL_ سجل",
                    "paginate": {
                        "next": "الصفحة التالية",
                        "previous": "الصفحة السابقة"
                    },
                    "zeroRecords": "لم يتم العثور على سجلات"
                }
            });
        });
    </script>

    
    <style>
        /* تنسيق رأس الجدول */
        #teachersInClassTable thead th {
            background-color: #f8f9fa;
            font-weight: bold;
            text-align: right;
            padding: 12px 15px;
        }
    </style>
}
