@model SchoolSystem.Models.ProfileViewModel
@{
    ViewData["Title"] = "معلوماتي";
    var isMinistry = Model.Role == SchoolSystem.Data.RoleNames.MinistryManager;
    var isDirectorate = Model.Role == SchoolSystem.Data.RoleNames.DirectorateManager;
    var organizationLabel = isMinistry ? "الوزارة" : isDirectorate ? "المديرية" : "المدرسة";
    var profileInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? string.Empty
        : Model.Name.Trim().Substring(0, 1).ToUpperInvariant();
}

<div class="container mt-5">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="m-0"><i class="bi bi-person-circle"></i> معلوماتي الشخصية</h4>
        </div>
        <div class="card-body">
            <div class="row justify-content-center">
                <!-- صورة الملف الشخصي -->
                <div class="profile-img-wrapper">
                    <label for="photoInput" class="profile-photo-label" title="تغيير الصورة الشخصية">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoPath) && Model.PhotoExists)
                        {
                            <img src="@Url.Action("GetImage", "Image", new { fileName = System.IO.Path.GetFileName(Model.PhotoPath) })"
                                class="profile-img modern-shadow"
                                alt="الصورة الشخصية لـ @Model.Name" />
                        }
                        else
                        {
                            <div class="profile-initial modern-shadow">
                                @if (!string.IsNullOrEmpty(profileInitial))
                                {
                                    <span>@profileInitial</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-fill" aria-hidden="true"></i>
                                }
                            </div>
                        }

                        <!-- زر تحميل الصورة -->
                        <span class="upload-icon" aria-hidden="true">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </label>

                    <form asp-action="UploadProfileImage" asp-controller="ImageProfile" enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="UserName" value="@Model.UserName" />
                        <input type="hidden" asp-for="Email" value="@Model.Email" />
                        <input type="hidden" asp-for="Id" value="@Model.Id" />
                        <input type="file" id="photoInput" name="ProfileImage" onchange="validateAndSubmit(this)" />
                    </form>
                </div>
                <!-- تفاصيل الملف الشخصي -->
                <div class="col-12 col-sm-8">
                    <dl class="row">
                        <dt class="col-sm-4"><i class="bi bi-person-fill me-2"></i>الاسم:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4"><i class="bi bi-credit-card-2-front me-2"></i> رقم الهوية:</dt>
                        <dd class="col-sm-8">@Model.IdNumber</dd>

                        <dt class="col-sm-4"><i class="bi bi-envelope-fill me-2"></i> الإيميل:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4"><i class="bi bi-phone-fill me-2"></i> الهاتف:</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>
                        @if (!isMinistry && !isDirectorate)
                        {
                            <dt class="col-sm-4"><i class="bi bi-calendar-event-fill me-2"></i> تاريخ الميلاد:</dt>
                            <dd class="col-sm-8">@Model.TheDate</dd>
                        }
                        @if (!isMinistry)
                        {
                            <dt class="col-sm-4"><i class="bi bi-geo-alt-fill me-2"></i> العنوان:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.City) && string.IsNullOrWhiteSpace(Model.Area) ? "غير محدد" : $"{Model.City} / {Model.Area}")</dd>
                        }
                        <dt class="col-sm-4"><i class="bi bi-building-fill me-2"></i> @organizationLabel:</dt>
                        <dd class="col-sm-8">@Model.School</dd>

                        @if((Context.Session.GetString("Role")??"Null") == "Student")
                        {
                            <dt class="col-sm-4"><i class="bi bi-journal-bookmark-fill me-2"></i> الصف:</dt>
                            <dd class="col-sm-8">@Model.TheClass</dd>
                        }

                        <dt class="col-sm-4"><i class="bi bi-shield-lock-fill me-2"></i> الحالة:</dt>
                        <dd class="col-sm-8">@Model.Role</dd>

                        <dt class="col-sm-4"><i class="bi bi-person-badge-fill me-2"></i> اسم المستخدم:</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-center gap-3 flex-wrap">
            <a asp-action="Edit" class="btn btn-outline-primary" asp-route-id="@Model.Id">تعديل المعلومات الشخصية</a>
            <a asp-controller="Account" asp-action="NewPassword" class="btn btn-outline-warning">تغيير كلمة المرور</a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function validateAndSubmit(input) {
            const file = input.files[0];

            if (!file) {
                alert("لم يتم اختيار أي ملف.");
                return;
            }

            const allowedTypes = ["image/jpeg", "image/jpg", "image/png"];
            if (!allowedTypes.includes(file.type)) {
                alert("الرجاء اختيار صورة بصيغة jpg أو png أو jpeg.");
                input.value = "";
                return;
            }

            if (file.size === 0) {
                alert("الصورة فارغة.");
                return;
            }

            input.form.submit();
        }
    </script>
    
    <style>

        .profile-img-wrapper {
            position: relative;
            width: 160px;
            height: 160px;
            margin: 0 auto 28px;
            flex: 0 0 160px;
        }

        .profile-photo-label {
            position: relative;
            display: block;
            width: 100%;
            height: 100%;
            margin: 0;
            border-radius: 50%;
            cursor: pointer;
        }

        .profile-img, .profile-initial {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #e0e0e0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .profile-initial {
            background: linear-gradient(135deg, #007bff, #6610f2);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 60px;
            font-weight: bold;
            line-height: 1;
        }

        .profile-initial .bi-person-fill {
            font-size: 72px;
        }

        .upload-icon {
            position: absolute;
            bottom: 4px;
            right: 4px;
            width: 42px;
            height: 42px;
            background-color: #ffffff;
            border: 3px solid #ffffff;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            box-shadow: 0 3px 10px rgba(0,0,0,0.25);
            color: #0d6efd;
            font-size: 19px;
            line-height: 1;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease;
        }

        .upload-icon:hover {
            background-color: #f0f0f0;
            transform: scale(1.06);
        }

        input[type="file"] {
            display: none;
        }
        /* تحسين استجابة البطاقة على الشاشات الصغيرة */
        @@media (max-width: 576px) {
            .profile-img-wrapper {
                width: 120px;
                height: 120px;
                flex-basis: 120px;
            }
            .profile-initial {
                font-size: 48px;
            }
            .profile-initial .bi-person-fill {
                font-size: 54px;
            }
            .upload-icon {
                width: 36px;
                height: 36px;
                right: 1px;
                bottom: 1px;
                font-size: 16px;
            }
            dl dt, dl dd {
                font-size: 0.9rem;
            }
            .card-footer .btn {
                font-size: 0.9rem;
                padding: 0.5rem 0.75rem;
            }
        }
    </style>
}

