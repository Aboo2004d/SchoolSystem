@{
    ViewData["Title"] = "لوحة المديرية";
}

<style>
    .directorate-stat-link { display: block; color: inherit; text-decoration: none; border-radius: 1rem; }
    .directorate-stat-card { transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; will-change: transform; }
    .directorate-stat-link:hover .directorate-stat-card,
    .directorate-stat-link:focus-visible .directorate-stat-card { transform: translateY(-7px); box-shadow: 0 .8rem 1.8rem rgba(0,0,0,.14) !important; border-color: rgba(13,110,253,.35); }
    .directorate-stat-link:focus-visible { outline: 3px solid rgba(13,110,253,.3); outline-offset: 4px; }
    .directorate-stat-card .card-header i { transition: transform .22s ease; display: inline-block; }
    .directorate-stat-link:hover .card-header i { transform: scale(1.16) rotate(-4deg); }
    @@media (prefers-reduced-motion: reduce) { .directorate-stat-card, .directorate-stat-card .card-header i { transition: none; } .directorate-stat-link:hover .directorate-stat-card { transform: none; } }
</style>
<div class="container mt-3 mt-md-5" dir="rtl">
    <div class="text-center mb-3 mb-md-4">
        <h2 class="mb-2"><i class="bi bi-speedometer2"></i> <span id="directorateName">لوحة المديرية</span></h2>
        <p class="text-muted mb-0">إحصاءات مجمعة لمدارس المديرية دون عرض بيانات شخصية.</p>
    </div><div id="dashboardLoading" class="text-center text-muted py-5" aria-live="polite"><div class="spinner-border text-primary mb-2" role="status"><span class="visually-hidden">جارٍ التحميل</span></div><div>جارٍ تحميل إحصاءات المديرية...</div></div>
    <div class="row g-3 g-md-4 d-none" id="cards" aria-label="إحصاءات المديرية"></div>
</div>

@section Scripts {
<script>
(async()=>{const loading=document.getElementById('dashboardLoading'),cardsContainer=document.getElementById('cards');try{const response=await fetch('/api/directorate/dashboard');if(!response.ok)throw new Error('تعذر تحميل لوحة المديرية.');const data=await response.json();document.getElementById('directorateName').textContent=data.directorate.name;const cards=[{title:'المدارس',value:data.schools,icon:'bi-buildings-fill',color:'primary',href:'/Directorate/Schools'},{title:'المدارس الفعالة',value:data.activeSchools,icon:'bi-patch-check-fill',color:'success',href:'/Directorate/ActiveSchools'},{title:'مديرو المدارس',value:data.managers,icon:'bi-person-vcard-fill',color:'info',href:'/Directorate/Managers'},{title:'المعلمون',value:data.teachers,icon:'bi-person-badge-fill',color:'warning',href:'/Directorate/Teachers'},{title:'الطلاب',value:data.students,icon:'bi-mortarboard-fill',color:'primary',href:'/Directorate/Students'},{title:'الصفوف',value:data.classes,icon:'bi-columns-gap',color:'success',href:'/Directorate/Classes'}];cardsContainer.innerHTML=cards.map(card=>`<div class="col-6 col-lg-4"><a class="directorate-stat-link h-100" href="${card.href}" aria-label="فتح ${card.title}"><article class="card directorate-stat-card shadow-sm rounded-4 h-100"><div class="card-header bg-${card.color} ${card.color==='warning'||card.color==='info'?'text-dark':'text-white'} text-center rounded-top-4 py-2 py-md-3"><h5 class="mb-0 fs-6"><i class="bi ${card.icon}"></i> ${card.title}</h5></div><div class="card-body d-flex align-items-center justify-content-center p-3 p-md-4"><span class="display-6 fw-bold text-${card.color}">${card.value}</span></div></article></a></div>`).join('');cardsContainer.classList.remove('d-none')}catch(error){notifyError(error.message)}finally{loading.classList.add('d-none')}})();
</script>
}
