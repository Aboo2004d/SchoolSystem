@{ ViewData["Title"] = ViewBag.FormTitle; }
<div class="container py-4" dir="rtl">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <h1 class="mb-0">@ViewBag.FormTitle</h1>
        <a class="btn btn-outline-secondary" href="/Directorate/@(ViewBag.PersonType == "manager" ? "Managers" : ViewBag.PersonType == "teacher" ? "Teachers" : "Students")"><i class="bi bi-arrow-right-circle"></i> عودة</a>
    </div>
    <form id="personForm" class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="name">الاسم الكامل</label><input class="form-control" id="name" maxlength="150" required /></div>
                <div class="col-md-6"><label class="form-label" for="idNumber">رقم الهوية</label><input class="form-control" id="idNumber" inputmode="numeric" pattern="[1-9][0-9]{8}" maxlength="9" required /></div>
                <div class="col-md-6"><label class="form-label" for="email">البريد الإلكتروني</label><input class="form-control" id="email" type="email" maxlength="200" required /></div>
                <div class="col-md-6"><label class="form-label" for="phone">رقم الهاتف</label><input class="form-control" id="phone" type="tel" maxlength="30" required /></div>
                <div class="col-md-6"><label class="form-label" for="birthDate">تاريخ الميلاد</label><input class="form-control" id="birthDate" type="date" required /></div>
                <div class="col-md-6"><label class="form-label" for="schoolId">المدرسة</label><select class="form-select" id="schoolId" required><option value="">اختر المدرسة</option></select></div>
                <div class="col-md-6 @(ViewBag.PersonType == "student" ? "" : "d-none")" id="classField"><label class="form-label" for="classId">الصف</label><select class="form-select" id="classId"><option value="">اختر المدرسة أولًا</option></select></div>
                <div class="col-md-6"><label class="form-label" for="city">المدينة</label><input class="form-control" id="city" maxlength="100" required /></div>
                <div class="col-md-6"><label class="form-label" for="area">الحي/المنطقة</label><input class="form-control" id="area" maxlength="100" required /></div>
            </div>
        </div>
        <div class="card-footer bg-white border-0 p-4 pt-0"><button id="submitButton" class="btn btn-success px-4" type="submit"><i class="bi bi-person-plus-fill"></i> حفظ البيانات</button></div>
    </form>
</div>
@section Scripts {
<script>
const personType='@ViewBag.PersonType';
const endpoint=`/api/directorate/${personType}s`;
const value=id=>document.getElementById(id).value.trim();
const escapeHtml=value=>String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
async function loadOptions(schoolId){const parameters=new URLSearchParams({personType});if(schoolId)parameters.set('schoolId',schoolId);const response=await fetch(`/api/directorate/directory-options?${parameters}`);if(!response.ok)throw new Error('تعذر تحميل خيارات النموذج.');return response.json()}
(async()=>{try{const options=await loadOptions();document.getElementById('schoolId').insertAdjacentHTML('beforeend',options.schools.map(x=>`<option value="${x.id}">${escapeHtml(x.name)}</option>`).join(''))}catch(error){notifyError(error.message)}})();
document.getElementById('schoolId').addEventListener('change',async event=>{if(personType!=='student')return;const select=document.getElementById('classId');select.innerHTML='<option value="">جارٍ التحميل...</option>';try{const options=event.target.value?await loadOptions(event.target.value):{classes:[]};select.innerHTML='<option value="">اختر الصف</option>'+options.classes.map(x=>`<option value="${x.id}">${escapeHtml(x.name)}</option>`).join('')}catch(error){select.innerHTML='<option value="">تعذر التحميل</option>';notifyError(error.message)}});
document.getElementById('personForm').addEventListener('submit',async event=>{event.preventDefault();if(!event.currentTarget.reportValidity())return;const button=document.getElementById('submitButton');button.disabled=true;try{const body={name:value('name'),idNumber:value('idNumber'),email:value('email'),phone:value('phone'),birthDate:value('birthDate'),schoolId:value('schoolId'),classId:personType==='student'?value('classId')||null:null,city:value('city'),area:value('area')};const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!response.ok){const error=await response.json().catch(()=>null);throw new Error(error?.message||Object.values(error?.errors||{}).flat()[0]||'تعذر حفظ البيانات.')}sessionStorage.setItem('directorateNotification','تمت إضافة السجل بنجاح.');location.href=`/Directorate/${personType==='manager'?'Managers':personType==='teacher'?'Teachers':'Students'}`}catch(error){notifyError(error.message);button.disabled=false}});
</script>
}
