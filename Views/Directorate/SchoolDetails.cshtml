@{ ViewData["Title"] = "تقرير المدرسة"; }

<style>
    .school-report .report-card { border: 0; border-radius: 1rem; box-shadow: 0 .25rem 1rem rgba(0,0,0,.08); }
    .school-report .metric-icon { width: 2.75rem; height: 2.75rem; display: inline-grid; place-items: center; border-radius: .8rem; font-size: 1.25rem; }
    .school-report .report-table-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-gutter: stable; }
    .school-report .report-table-scroll table { min-width: 760px; margin-bottom: 0; white-space: nowrap; }
    .school-report .report-table-scroll { direction: rtl; padding-inline: 1px; }
    .school-report .report-table-scroll th:first-child,
    .school-report .report-table-scroll td:first-child { position: static; width: 64px; min-width: 64px; max-width: 64px; text-align: center; }
    .school-report .report-table-scroll::-webkit-scrollbar { height: 10px; }
    .school-report .report-table-scroll::-webkit-scrollbar-thumb { background: #9eacba; border-radius: 50rem; }
    @@media print { .no-print, header, footer { display: none !important; } .school-report .report-card { box-shadow: none; border: 1px solid #ddd; } }
</style>

<div class="container py-4 school-report" dir="rtl">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
        <div><a asp-action="Schools" class="text-decoration-none"><i class="bi bi-arrow-right ms-1"></i>مدارس المديرية</a><h1 class="h2 fw-bold mt-2 mb-1" id="schoolName">تقرير المدرسة</h1><p class="text-muted mb-0">تقرير تشغيلي وتعليمي مجمع.</p></div>
        <div class="d-flex gap-2"><a class="btn btn-outline-danger" href="/api/directorate/schools/@ViewBag.SchoolId/report.pdf"><i class="bi bi-file-earmark-pdf-fill"></i> تصدير PDF</a><a class="btn btn-outline-secondary" asp-action="Schools">عودة</a></div>
    </div>
    <div id="reportLoading" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="text-muted mt-2">جارٍ إعداد التقرير...</div></div>

    <div id="reportContent" class="d-none">
        <section class="card report-card mb-4 overflow-hidden">
            <div class="card-header bg-primary text-white p-3"><h2 class="h5 mb-0"><i class="bi bi-building ms-2"></i>بطاقة المدرسة</h2></div>
            <div class="card-body p-3 p-md-4"><div class="row g-3" id="schoolProfile"></div></div>
        </section>

        <section class="row g-3 mb-4" id="summaryCards" aria-label="المؤشرات الرئيسية"></section>

        <div class="row g-4 mb-4">
            <div class="col-lg-6"><section class="card report-card h-100"><div class="card-header bg-success text-white"><h2 class="h5 mb-0"><i class="bi bi-calendar-check ms-2"></i>الحضور والغياب</h2></div><div class="card-body"><div class="row g-3" id="attendanceMetrics"></div></div></section></div>
            <div class="col-lg-6"><section class="card report-card h-100"><div class="card-header bg-info text-dark"><h2 class="h5 mb-0"><i class="bi bi-bar-chart-line ms-2"></i>الأداء الأكاديمي</h2></div><div class="card-body"><div class="row g-3" id="academicMetrics"></div></div></section></div>
        </div>

        <section class="card report-card mb-4 overflow-hidden">
            <div class="card-header bg-light"><h2 class="h5 mb-0"><i class="bi bi-graph-up-arrow ms-2"></i>توزيع العلامات</h2></div>
            <div class="report-table-scroll"><table class="table table-bordered table-hover align-middle"><thead class="table-light"><tr><th>#</th><th>فئة العلامة</th><th>عدد السجلات</th><th>النسبة</th></tr></thead><tbody id="gradeDistributionRows"></tbody></table></div>
        </section>
        <section class="card report-card mb-4 overflow-hidden">
            <div class="card-header bg-light d-flex justify-content-between align-items-center"><h2 class="h5 mb-0"><i class="bi bi-columns-gap ms-2"></i>توزيع الصفوف</h2><span class="small text-muted"><i class="bi bi-arrows-expand-vertical"></i> مرّر أفقيًا لعرض جميع الأعمدة</span></div>
            <div class="report-table-scroll"><table class="table table-bordered table-hover align-middle"><thead class="table-light"><tr><th>#</th><th>اسم الصف</th><th>المرحلة</th><th>رقم الصف</th><th>الشعبة</th><th>الفرع</th><th>عدد الطلاب</th></tr></thead><tbody id="classesRows"></tbody></table></div>
        </section>

        <section class="card report-card mb-4 overflow-hidden">
            <div class="card-header bg-light d-flex justify-content-between align-items-center"><h2 class="h5 mb-0"><i class="bi bi-journal-bookmark ms-2"></i>المواد التعليمية</h2><span class="small text-muted"><i class="bi bi-arrows-expand-vertical"></i> مرّر أفقيًا لعرض جميع الأعمدة</span></div>
            <div class="report-table-scroll"><table class="table table-bordered table-hover align-middle"><thead class="table-light"><tr><th>#</th><th>المادة</th><th>المعلمون المكلفون</th><th>الصفوف المرتبطة</th><th>حالة التغطية</th></tr></thead><tbody id="subjectsRows"></tbody></table></div>
        </section>
        <p class="text-muted small text-center" id="generatedAt"></p>
    </div>
</div>

@section Scripts {
<script>
(async()=>{const id='@ViewBag.SchoolId';try{const response=await fetch(`/api/directorate/schools/${id}/report`);if(!response.ok)throw new Error('تعذر تحميل تقرير المدرسة.');const data=await response.json();renderReport(data);document.getElementById('reportContent').classList.remove('d-none')}catch(error){notifyError(error.message)}finally{document.getElementById('reportLoading').classList.add('d-none')}})();
function renderReport(data){const school=data.school;document.getElementById('schoolName').textContent=school.name;document.getElementById('schoolProfile').innerHTML=[['الحالة',school.isActive?'فعالة':'معطلة'],['التصنيف الرسمي',school.status||'غير محدد'],['النوع',school.gender||'غير محدد'],['المرحلة',school.stage||'غير محددة'],['أدنى صف',school.minClass??'غير محدد'],['أعلى صف',school.maxClass??'غير محدد']].map(x=>`<div class="col-6 col-lg-4"><div class="text-muted small">${x[0]}</div><div class="fw-bold mt-1">${escapeHtml(x[1])}</div></div>`).join('');const cards=[['المديرون',data.summary.managers,'bi-person-vcard','primary'],['المعلمون',data.summary.teachers,'bi-person-badge','success'],['الطلاب',data.summary.students,'bi-mortarboard','info'],['الصفوف',data.summary.classes,'bi-columns-gap','warning'],['المواد',data.summary.subjects,'bi-journal-bookmark','primary']];document.getElementById('summaryCards').innerHTML=cards.map(x=>`<div class="col-6 col-lg"><article class="card report-card h-100"><div class="card-body d-flex align-items-center gap-3"><span class="metric-icon bg-${x[3]}-subtle text-${x[3]}"><i class="bi ${x[2]}"></i></span><div><div class="text-muted small">${x[0]}</div><div class="fs-3 fw-bold">${x[1]}</div></div></div></article></div>`).join('');document.getElementById('attendanceMetrics').innerHTML=metricRows([['إجمالي السجلات',data.attendance.total],['حضور',data.attendance.present],['غياب',data.attendance.absent],['غياب بعذر',data.attendance.excused],['نسبة الالتزام',data.attendance.attendanceRate==null?'لا توجد بيانات':`${data.attendance.attendanceRate}%`]]);document.getElementById('academicMetrics').innerHTML=metricRows([['سجلات العلامات',data.academic.gradeRecords],['متوسط العلامات',data.academic.averageGrade==null?'لا توجد بيانات':`${data.academic.averageGrade}%`]]);document.getElementById('gradeDistributionRows').innerHTML=data.academic.distribution.length?data.academic.distribution.map((x,i)=>`<tr><td>${i+1}</td><td class="fw-semibold">${escapeHtml(x.label)}</td><td>${x.count}</td><td>${x.percentage}%</td></tr>`).join(''):'<tr><td colspan="4" class="text-center text-muted py-4">لا توجد علامات مسجلة</td></tr>';document.getElementById('classesRows').innerHTML=data.classes.length?data.classes.map((x,i)=>`<tr><td>${i+1}</td><td class="fw-semibold">${escapeHtml(x.name)}</td><td>${escapeHtml(x.stage||'-')}</td><td>${x.numberClass??'-'}</td><td>${x.section??'-'}</td><td>${escapeHtml(x.branch||'-')}</td><td><span class="badge bg-primary">${x.students}</span></td></tr>`).join(''):'<tr><td colspan="7" class="text-center text-muted py-4">لا توجد صفوف مسجلة</td></tr>';document.getElementById('subjectsRows').innerHTML=data.subjects.length?data.subjects.map((x,i)=>`<tr><td>${i+1}</td><td class="fw-semibold">${escapeHtml(x.name)}</td><td>${x.teachers}</td><td>${x.classes}</td><td><span class="badge ${x.teachers&&x.classes?'bg-success':'bg-warning text-dark'}">${x.teachers&&x.classes?'مغطاة':'تحتاج متابعة'}</span></td></tr>`).join(''):'<tr><td colspan="5" class="text-center text-muted py-4">لا توجد مواد مسجلة</td></tr>';document.getElementById('generatedAt').textContent=`تاريخ إنشاء التقرير: ${new Date(data.generatedAt).toLocaleString('ar')}`}
function metricRows(items){return items.map(x=>`<div class="col-6"><div class="border rounded-3 p-3 h-100"><div class="text-muted small">${x[0]}</div><div class="fs-4 fw-bold mt-1">${x[1]}</div></div></div>`).join('')}
function escapeHtml(value){return String(value??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
</script>
}
