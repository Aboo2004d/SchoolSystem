@model SchoolSystem.Models.LectuerTeacherViewModel

@{
    ViewData["Title"] = "إضافة معلم للصف";
    string idClass = ViewBag.IdClass;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-header bg-info text-white text-center">
                    <h4 class="mb-0">إضافة معلم للصف: @ViewBag.NameLectuer</h4>
                </div>
                <div class="card-body">
                    <form id="teacherClassForm">
                        <div id="validationSummary" class="text-danger mb-3"></div>

                        <input type="hidden" id="IdClass" name="IdClass" value="@idClass" />

                        <div class="mb-3">
                            <label for="IdTeacher" class="form-label fw-bold">المعلم:</label>
                            <select class="form-control select2-teacher" id="teacherSelect" name="IdTeacher">
                                <option></option>
                            </select>
                            <span id="IdTeacherError" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label for="IdLectuer" class="form-label fw-bold">المادة:</label>
                            <select class="form-control select2-lectuer" id="lectuerSelect" name="IdLectuer">
                                <option></option>
                            </select>
                            <span id="IdLectuerError" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-outline-success px-4" id="submitBtn">
                                <i class="bi bi-save"></i> حفظ
                            </button>
                            <a class="btn btn-outline-secondary px-4" id="backBtn">
                                <i class="bi bi-arrow-left-circle"></i> عودة
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    $(document).ready(function () {
        $('.select2-teacher').select2({
            placeholder: "اختر معلم...",
            allowClear: true,
            width: '100%'
        });
        $('.select2-lectuer').select2({
            placeholder: "اختر صف...",
            allowClear: true,
            width: '100%'
        });

        const idClass = "@idClass";
        const apiUrl = `/api/theClass/CreateTeacherClass?idClass=${idClass}`;

        // تحميل المعلمين
        $.getJSON(apiUrl, function (res) {
            if (!res || res.success === false) {
                $("#validationSummary").text(res.message || "فشل تحميل القوائم.");
                return;
            }

            const $select_teacher = $('#teacherSelect');
            $select_teacher.empty();
            res.teachers.forEach(teacher => {
                $select_teacher.append(new Option(teacher.nameTeacher, teacher.idTeacher));
            });

            const $select_lectuer = $('#lectuerSelect');
            $select_lectuer.empty();
            res.lectuers.forEach(lectuer => {
                $select_lectuer.append(new Option(lectuer.nameLectuer, lectuer.idLectuer));
            });
            console.log("بيانات المواد:", res.lectuers);
        }).fail(function () {
            $("#validationSummary").text("فشل تحميل القوائم.");
        });

        // زر العودة
        $("#backBtn").click(function () {
            window.location.href = `/Menegar/ManagerMenegarTeacherInClassView?idClass=${idClass}`;
        });

        // إرسال النموذج
        $("#teacherClassForm").submit(function (e) {
            e.preventDefault();
            $("#submitBtn").prop("disabled", true);
            $("#validationSummary").text("");
            $("#IdTeacherError").text("");
            $("#IdLectuerError").text("");

            const payload = {
                idClass: $("#IdClass").val(),
                idTeacher: $("#teacherSelect").val(),
                idLectuer: $("#lectuerSelect").val()
            };

            console.log("بيانات الإرسال:", payload);

            $.ajax({
                url: '/api/theClass/CreateTeacherClass',
                method: 'POST',
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function () {
                    notifySuccess("تم الحفظ بنجاح");
                    setTimeout(() => {
                        window.location.href = `/Menegar/ManagerMenegarTeacherInClassView?idClass=${idClass}`;
                    }, 1500);
                },
                error: function (xhr) {
                    console.log("خطأ بالرد:", xhr);
                    const error = xhr.responseJSON?.message || "حدث خطأ غير متوقع";
                    notifyError(error);
                    $("#submitBtn").prop("disabled", false);
                }
            });
        });
    });
</script>
}
